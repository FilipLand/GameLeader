    <mxGraphModel dx="2811" dy="1154" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    direction TB\n\n    class UserRole {\n        &lt;&lt;enumeration&gt;&gt;\n        USER\n        ADMIN\n    }\n\n    class GameStatus {\n        &lt;&lt;enumeration&gt;&gt;\n        PLAYING\n        COMPLETED\n        DROPPED\n        PLAN_TO_PLAY\n    }\n\n    class GuideCategory {\n        &lt;&lt;enumeration&gt;&gt;\n        PASO_A_PASO\n        TROFEOS\n        COLECCIONABLES\n        ESTRATEGIA\n    }\n\n    class User {\n        -userId: Long\n        -username: String\n        -email: String\n        -passwordHash: String\n        -firebaseUid: String\n        -avatarUrl: String\n        -bannerUrl: String\n        -bio: String\n        -role: UserRole\n        -createdAt: DateTime\n        +register() Boolean\n        +loginWithEmail(email, pass) AuthToken\n        +loginWithOAuth(provider) AuthToken\n        +updateProfile(data) void\n        +followUser(targetUser) void\n        +unfollowUser(targetUser) void\n    }\n\n    class Admin {\n        +addGameToCatalog(gameData) Game\n        +editGame(gameId, gameData) Game\n        +deleteReview(reviewId) void\n        +moderateGuide(guideId) void\n    }\n\n    class Game {\n        -gameId: Long\n        -title: String\n        -description: Text\n        -coverUrl: String\n        -publisher: String\n        -genre: String\n        -ratingBayesian: Float\n        -hasInteractiveMap: Boolean\n        +calculateBayesianRating() Float\n        +syncFromExternalAPI(apiId) void\n        +getTopGuides() List\n    }\n\n    class UserGameCollection {\n        -collectionId: Long\n        -status: GameStatus\n        -hoursPlayed: Float\n        -progressPercentage: Float\n        -startedAt: DateTime\n        -completedAt: DateTime\n        +changeStatus(newStatus) void\n        +logHours(hours) void\n        +updateProgress(percentage) void\n    }\n\n    class Review {\n        -reviewId: Long\n        -rating: Float\n        -content: Text\n        -createdAt: DateTime\n        +publish() void\n        +edit(newContent, newRating) void\n        +delete() void\n    }\n\n    class Guide {\n        -guideId: Long\n        -title: String\n        -category: GuideCategory\n        -content: LongText\n        -createdAt: DateTime\n        +publish() void\n        +edit(title, content) void\n        +getUsefulScore() Integer\n    }\n\n    class GuideRating {\n        -isUseful: Boolean\n        +vote(isUseful) void\n    }\n\n    class InteractiveMap {\n        -mapId: Long\n        -tileServerUrl: String\n        -defaultZoom: Integer\n        +loadMarkers() List\n        +zoomIn() void\n        +pan(x, y) void\n    }\n\n    class Follow {\n        -createdAt: DateTime\n    }\n\n    User &lt;|-- Admin : Herencia\n    User \&quot;1\&quot; --&gt; \&quot;0..*\&quot; UserGameCollection : gestiona\n    Game \&quot;1\&quot; --&gt; \&quot;0..*\&quot; UserGameCollection : pertenece a\n    User \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Review : escribe\n    Game \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Review : recibe\n    User \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Guide : redacta\n    Game \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Guide : tiene\n    User \&quot;1\&quot; --&gt; \&quot;0..*\&quot; GuideRating : valora\n    Guide \&quot;1\&quot; *-- \&quot;0..*\&quot; GuideRating : composicion\n    Game \&quot;1\&quot; *-- \&quot;0..1\&quot; InteractiveMap : posee\n    User \&quot;1\&quot; -- \&quot;0..*\&quot; Follow : follower\n    User \&quot;1\&quot; -- \&quot;0..*\&quot; Follow : following&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="641QNkUe1ymgPx55UlyA-274">
